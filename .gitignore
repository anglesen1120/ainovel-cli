# Nếu bạn thích mẫu danh sách cho phép thay vì danh sách từ chối, hãy xem mẫu cộng đồng:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Tệp nhị phân cho chương trình và plugin
*.exe
*.exe~
*.dll
*.so
*.dylib

# Tệp nhị phân kiểm thử, được tạo bằng `go test -c`
*.test

# Hồ sơ độ bao phủ mã và các tạo phẩm kiểm thử khác
*.out
coverage.*
*.coverprofile
profile.cov

# Thư mục phụ thuộc (xóa chú thích bên dưới để đưa vào)
# vendor/

# Tệp không gian làm việc Go
go.work
go.work.sum

# Tệp env
.env

# dotdir cấu hình cấp dự án (phản chiếu ~/.ainovel/): config.json chứa khóa, rules/ là tùy chọn viết cục bộ
.ainovel/

# Trình soạn thảo/IDE
.idea/
.vscode/
.cache
.DS_Store

# Tạo phẩm GoReleaser
dist/
release-notes.md
/ainovel-cli

tasks
refer/
output*
workspace/