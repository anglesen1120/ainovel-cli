{
  // Provider, model và mức suy luận mặc định.
  // ★ Giá trị provider là một key trong providers bên dưới (một “con trỏ”), không phải tên giao thức —
  //   Khi đổi provider phải bảo đảm providers có mục cùng tên, nếu không khởi động sẽ báo “chưa cấu hình thông tin xác thực”.
  //   Lúc chạy dùng /config để quản lý thư viện Provider/model, dùng /model để chuyển giữa các model đã lưu.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Tùy chọn. Mức suy luận mặc định：off / low / medium / high / xhigh / max。
  // Bỏ trống hoặc chuỗi rỗng = không ghi đè, dùng mặc định của model/provider.
  "reasoning_effort": "medium",

  // Kho thông tin xác thực Provider. key tự đặt, dùng làm đích tham chiếu cho trường provider phía trên.
  // Provider đã biết（openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock）
  // Có thể bỏ qua type; proxy tùy biến phải khai báo type rõ ràng để chỉ định giao thức API.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai báo ứng viên trong panel /model và cửa sổ ngữ cảnh riêng của model; mảng chuỗi cũ vẫn tương thích.
      // json_schema là ghi đè rõ ràng cho đầu ra có cấu trúc native：true=xác nhận hỗ trợ，false=xác nhận không hỗ trợ，
      // bỏ qua = dùng khả năng adapter. Nên điền rõ khi dùng trung chuyển tùy biến hoặc khả năng phụ thuộc model cụ thể.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Truyền nguyên văn các tham số bổ sung cho mỗi request tới provider này (các tham số sampling như temperature/top_p/
      // min_p，hoặc key riêng nhà cung cấp như chat_template_kwargs của nvidia để bật think），được gộp nguyên văn vào request body。
      // chỉ có hiệu lực với provider tương thích OpenAI（openrouter/deepseek/qwen/glm/grok/ollama…）；
      // type:"openai" sẽ lọc theo danh sách tham số chính thức. Người dùng tự chịu trách nhiệm về giá trị.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp provider, truyền tới tầng HTTP client (không phải request body), dùng khi cần
      // proxy tùy biến User-Agent / headers / anthropic_beta.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4-6", "json_schema": true }]
    },
    "ollama": {
      // ollama / bedrock / proxy tùy biến có type rõ ràng có thể bỏ qua api_key
      // base_url cần kèm /v1（ollama có endpoint tương thích OpenAI nằm dưới /v1）
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Tùy chọn. Watchdog khi stream idle (Go duration, mặc định "5m"): LocalAI/ollama, v.v.
      // Khối đầu tiên của suy luận chậm cục bộ có thể vượt quá 5 phút, nới lỏng theo provider, không ảnh hưởng các kênh khác
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Tùy chỉnh Anthropic proxy. Nếu upstream chỉ cho phép Claude Code client truy cập,
      // dùng extra để truyền tiếp user_agent / anthropic_beta / headers.
      // base_url không cần có /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Tùy chỉnh OpenAI/NewAPI proxy. Nếu upstream chỉ cho phép Codex client truy cập,
      // dùng extra để ghi đè User-Agent, và truyền tiếp các header nhận diện của Codex.
      // base_url điền theo địa chỉ thật của proxy; OpenAI protocol thường cần /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000, "json_schema": true },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Tùy chọn. OpenAI protocol endpoint: chat (mặc định /v1/chat/completions)/
      // responses (/v1/responses). Proxy kiểu Codex thường cần responses.
      "api": "responses",
      "extra": {
        // Tùy chọn. Khóa route cache prompt_cache_key mặc định chỉ gửi tới api.openai.com chính thức —
        // các đầu cuối tương thích bên thứ ba không có cam kết thống nhất cho trường không xác định (Groq/Cerebras/Volcano strict endpoints sẽ 400,
        // các proxy trung gian kiểu đóng gói lại sẽ âm thầm bỏ qua). Khi bạn xác nhận proxy trung gian của mình
        // chuyển tiếp nguyên trạng request body tới OpenAI, bật mục này sẽ có độ bám cache route (tăng tỉ lệ trúng cache).
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Tùy chọn. Ghi đè model mặc định theo vai trò; vai trò chưa cấu hình sẽ dùng model ở trên.
  // reasoning_effort cũng có thể ghi đè theo vai trò; nếu không cấu hình thì kế thừa reasoning_effort cấp trên.
  // Vai trò: architect / writer / editor. fallbacks sẽ thử lần lượt khi model chính thất bại.
  // Lưu ý: provider ở đây cũng là “con trỏ”, phải trỏ tới key tồn tại trong providers.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Phong cách viết: default / suspense / fantasy / romance.
  "style": "default"

  // Bộ đệm cửa sổ ngữ cảnh toàn cục kiểu cũ, giữ lại làm phương án dự phòng cho mọi model. Ưu tiên thấp hơn models[].context_window,
  // cao hơn model registry và giá trị mặc định 200k. Chỉ ảnh hưởng ngưỡng nén, không đổi độ dài request thực tế của API.
  // "context_window": 300000

  // Tùy chọn. Ngân sách chi phí cho một quyển sách (thư mục output), cầu chì bảo hiểm. Chỉ bật khi book_usd > 0.
  // Khi tổng chi tiêu chạm warn_ratio thì cảnh báo mà không dừng; khi đạt 100% thì sau khi task con hiện tại kết thúc
  // sẽ dừng mềm (hard_stop=true thì vượt ngưỡng là dừng ngay). Sau khi dừng, chỉ cần tăng book_usd là có thể tiếp tục chạy.
  // Lưu ý: model tùy chỉnh nếu registry không tìm thấy giá và provider không tự báo cost, thì ngân sách chỉ là hình thức.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Tùy chọn. Cảnh báo không cần giám sát, mặc định bật (Windows notification / macOS osascript / Linux notify-send).
  // Sau khi cấu hình command thì chuyển sang lệnh tùy chỉnh (gửi push lên điện thoại qua đây): các trường qua biến môi trường
  // NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND / NOTIFY_LEVEL được truyền qua biến môi trường, toàn bộ JSON đồng thời ghi vào stdin.
  // Unix shell dùng $NOTIFY_TITLE; Windows PowerShell dùng $env:NOTIFY_TITLE.
  // events có thể lọc tùy chọn: run_end / budget / advance_gate / stop_guard /
  // plan_start / deadlock / worker_failure; mặc định bật tất cả.
  // "notify": {
  //   "enabled": true,
  //   // Tiêu đề/nội dung có tiếng Việt và khoảng trắng, phải truyền tham số bằng --data-urlencode, không được nối vào đường dẫn URL hoặc HTTP header.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }
}
